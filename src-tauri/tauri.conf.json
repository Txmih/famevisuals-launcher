{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "FameLauncher",
  "version": "1.2.0",
  "identifier": "com.famevisuals.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FameLauncher",
        "width": 1100,
        "height": 680,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["WebView2Loader.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwQjBGNTM4NjdBNEIwQzkKUldUSnNLUm5PUFd3RU5JRlVMSitmaUpPZGFMVGZzdW5VVGNLcVJIb3BMQzdpTFU5NktDdXhDOVUK",
      "endpoints": [
        "https://github.com/Txmih/famevisuals-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
